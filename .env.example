# Copy this file to .env and fill in real values.

# Leave true to run entirely on realistic mock data (safe for rehearsal,
# no DB connection needed). Set to false once the read-only DB is wired up.
DEMO_MODE=false

# --- Read-only osTicket database replica ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=helpdesk
DB_USER=root
DB_PASSWORD=

# --- Access control ---
# Optional shared secret appended as ?token=... to the dashboard URL and
# sent as X-Kiosk-Token by the frontend. Leave blank to rely solely on the
# network/VLAN restriction (recommended: use BOTH, see README).
KIOSK_TOKEN=4TGcvZu8oFzZPzpyfgKBuXjRzTuZhrFMMyJgsDmbUmu


PORT=8080
